{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "A gallery entry: entries/<id>.json",
  "description": "tools/lib/entry.mjs is what the checks run; this file is for editors and for reading.",
  "type": "object",
  "required": [
    "title",
    "description",
    "author",
    "entry"
  ],
  "additionalProperties": false,
  "properties": {
    "title": {
      "$ref": "#/$defs/texts"
    },
    "description": {
      "$ref": "#/$defs/texts"
    },
    "author": {
      "description": "A name, or a list of authors, each with a name and an optional https link.",
      "oneOf": [
        {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        },
        {
          "type": "array",
          "minItems": 1,
          "maxItems": 8,
          "items": {
            "type": "object",
            "required": [
              "name"
            ],
            "additionalProperties": false,
            "properties": {
              "name": {
                "type": "string",
                "minLength": 1,
                "maxLength": 80
              },
              "url": {
                "type": "string",
                "pattern": "^https://"
              }
            }
          }
        }
      ]
    },
    "license": {
      "description": "An SPDX id. Required for an example kept in this repository, whose directory then holds a LICENSE with that text; for a design in another repository it replaces the licence of the repository (a reviewer checks it).",
      "type": "string"
    },
    "tags": {
      "description": "Up to 8 tags to find the design by.",
      "type": "array",
      "maxItems": 8,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[a-z0-9][a-z0-9-]{0,31}$"
      }
    },
    "source": {
      "description": "A public GitHub repository at one commit. Leave it out for an example kept in this repository, in examples/<id>/.",
      "type": "object",
      "required": [
        "repo",
        "commit"
      ],
      "additionalProperties": false,
      "properties": {
        "repo": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$"
        },
        "commit": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        }
      }
    },
    "entry": {
      "description": "The netlist the Viewer opens, relative to the repository (or to examples/<id>/).",
      "type": "string",
      "pattern": "\\.(sp|spi|cir|net|scs)$"
    },
    "paths": {
      "description": "Directories searched for include files given by name only, in order. Default: the entry's directory.",
      "type": "array",
      "maxItems": 50,
      "items": {
        "type": "string"
      }
    },
    "add": {
      "description": "Files or directories to add besides what the netlist includes (a directory is taken with what is below it).",
      "type": "array",
      "maxItems": 50,
      "items": {
        "type": "string"
      }
    },
    "packages": {
      "description": "Packages to load: from the public catalog, a file of the repository, or a raw.githubusercontent.com address.",
      "type": "array",
      "maxItems": 20,
      "items": {
        "oneOf": [
          {
            "type": "object",
            "required": [
              "name",
              "version"
            ],
            "additionalProperties": false,
            "properties": {
              "name": {
                "type": "string"
              },
              "version": {
                "type": "string"
              }
            }
          },
          {
            "type": "object",
            "required": [
              "path"
            ],
            "additionalProperties": false,
            "properties": {
              "path": {
                "type": "string"
              }
            }
          },
          {
            "type": "object",
            "required": [
              "url"
            ],
            "additionalProperties": false,
            "properties": {
              "url": {
                "type": "string",
                "pattern": "^https://raw\\.githubusercontent\\.com/"
              }
            }
          }
        ]
      }
    },
    "formats": {
      "description": "The files that have to be told how to be read, by path: the format of each, a name the core lists (spice or spectre).",
      "type": "object",
      "maxProperties": 50,
      "additionalProperties": {
        "type": "string"
      }
    },
    "cover": {
      "description": "What the thumbnail shows and the viewer opens first: the schematic of a cell, or its symbol. Not together with level.",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "cell": {
          "type": "string",
          "description": "A subcircuit name, or \"(top)\" for the netlist's own level."
        },
        "view": {
          "enum": [
            "schematic",
            "symbol"
          ],
          "default": "schematic"
        }
      }
    },
    "level": {
      "description": "The older way to say {\"cover\": {\"cell\": …}}: a subcircuit name, or \"(top)\". Not together with cover.",
      "type": "string"
    }
  },
  "$defs": {
    "texts": {
      "type": "object",
      "required": [
        "en"
      ],
      "additionalProperties": {
        "type": "string",
        "minLength": 1
      },
      "propertyNames": {
        "pattern": "^[a-z]{2,3}(-[A-Za-z0-9]+)?$"
      }
    }
  }
}
