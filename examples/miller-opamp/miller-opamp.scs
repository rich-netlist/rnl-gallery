// Two-stage Miller-compensated op-amp, in a unity-gain buffer testbench
// A five-transistor OTA first stage, a PMOS common-source second stage M6/M7 and the compensation RZ + CC,
// biased by a mirror of IREF. The top level connects it as a unity-gain buffer.
// @RNL(type="header") { @USE-PACKAGE(name="rnl-std-all", version="0.4"); @VERSION("0.4") }
simulator lang=spectre

model nch mos1 type=n vto=0.5 kp=200u lambda=0.1
model pch mos1 type=p vto=-0.5 kp=80u lambda=0.1

subckt miller2 inp inn out vdd vss
IREF (vdd nb) isource dc=20u
M8 (nb nb vss vss) nch w=4u l=1u
M5 (tail nb vss vss) nch w=8u l=1u
M1 (x inn tail vss) nch w=10u l=0.5u
M2 (y inp tail vss) nch w=10u l=0.5u
M3 (x x vdd vdd) pch w=10u l=0.5u
M4 (y x vdd vdd) pch w=10u l=0.5u
M6 (out y vdd vdd) pch w=40u l=0.5u
M7 (out nb vss vss) nch w=16u l=1u
RZ (y z) resistor r=2k
CC (z out) capacitor c=3p
// @RNL {
//   &vdd @ADD-TO $SUPPLY_NET_SET;
//   &vss @ADD-TO $GROUND_NET_SET;
