//   %pvn  = $IO_PORT @ATTACH &vn  => @PLACE(34, 14) => @ORIENT("MY");
//   %pout = $IO_PORT @ATTACH &out => @PLACE(48, 18) => @ORIENT("MY");
//
//   %sup1 = $SUPPLY @ATTACH &vdd => @PLACE(6, 22);
//   %sup2 = $SUPPLY @ATTACH &vdd => @PLACE(22, 28);
//   %gnd  = $GROUND @ATTACH &vss => @PLACE(22, 0);
//
//   #RB  @PLACE(6, 16)  => @ORIENT("R0");
//   #MB  @PLACE(6, 6)   => @ORIENT("MY");
//   #PL  @PLACE(16, 22) => @ORIENT("MY");
//   #PR  @PLACE(28, 22) => @ORIENT("R0");
//   #MP  @PLACE(16, 14) => @ORIENT("R0");
//   #MN  @PLACE(28, 14) => @ORIENT("MY");
//   #MT  @PLACE(22, 6)  => @ORIENT("R0");
//   #XI0 @PLACE(36, 18) => @ORIENT("R0");
//   #XI1 @PLACE(44, 18) => @ORIENT("R0");
//
//   /* --- 3. Explicit Manhattan Wiring --- */
//   &vdd @WIRE { %sup1:p #RB:1 };
//   %jvdd = (22, 26);
//   $JUNCTION @ATTACH %jvdd;
//   &vdd @WIRE { %sup2:p %jvdd };
//   &vdd @WIRE { %jvdd (16, 26) #PL:s };
//   &vdd @WIRE { %jvdd (28, 26) #PR:s };
