//
//   &vp @WIRE { %pvp:p #MP:g };
//   &vn @WIRE { %pvn:p #MN:g };
//
//   %jtail = (22, 10);
//   $JUNCTION @ATTACH %jtail;
//   &tail @WIRE { #MP:s (16, 10) %jtail (28, 10) #MN:s };
