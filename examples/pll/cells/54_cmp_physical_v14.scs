//   {%pvp #MP #PR #XI0 #XI1 %pout} @AS(direction="left-to-right") $FLOW;
//
//   /* Continuous Static DC Bias Currents */
//   #RB:1 @CURRENT("in"); #RB:2 @CURRENT("out");
//   #MB:d @CURRENT("in"); #MB:s @CURRENT("out");
//   #PL:s @CURRENT("in"); #PL:d @CURRENT("out");
//   #PR:s @CURRENT("in"); #PR:d @CURRENT("out");
//   #MP:d @CURRENT("in"); #MP:s @CURRENT("out");
//   #MN:d @CURRENT("in"); #MN:s @CURRENT("out");
//   #MT:d @CURRENT("in"); #MT:s @CURRENT("out");
//
//   /* --- 2. Schematic Placement & Orientation --- */
