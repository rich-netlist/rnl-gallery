//
//   /* --- 4. Annotations --- */
//   (104, 28) @TEXT("tx_fll_counter_pdk110_71: 14-Bit Glitch-Free Gated Asynchronous Ripple Counter", halign="middle") => @SET-STYLE $title_style;
//   (104, 26.2) @TEXT("Low-Phase Latch Synchronizer (XCI, XGE, XG) + 14 Toggle Flip-Flops (XF0..XF13) Feeding Single Output Bus Q<13:0>", halign="middle") => @SET-STYLE $subtitle_style
