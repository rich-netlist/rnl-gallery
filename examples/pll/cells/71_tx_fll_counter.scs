//   %cnt = {#XCI #XGE #XG}(clock_gating) {#XF0 #XF1 #XF2 #XF3 #XF4 #XF5 #XF6 #XF7 #XF8 #XF9 #XF10 #XF11 #XF12 #XF13}(toggle_stages) @AS(bits=14, architecture="asynchronous_ripple_carry") $RIPPLE_COUNTER;
//   {%pclk #XG #XF0 #XF1 #XF2 #XF3 #XF4 #XF5 #XF6 #XF7 #XF8 #XF9 #XF10 #XF11 #XF12 #XF13 %pq} @AS(direction="left-to-right") $FLOW;
//   $NO_CONNECT @ATTACH #XF13:qb;
//
//   /* --- 2. Schematic Placement & Orientation --- */
//   {&q1 &q2 &q3 &q4 &q5 &q6 &q7 &q8 &q9 &q10 &q11 &q12 &q13} @REMOVE-FROM $PORT_FILL_SET;
