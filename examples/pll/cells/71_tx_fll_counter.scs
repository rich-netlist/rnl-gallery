//   #XF12 @PLACE(180, 14) => @ORIENT("R0");
//   #XF13 @PLACE(192, 14) => @ORIENT("R0");
//
//   /* --- 3. Explicit Manhattan, Single-Line Bus & Flying-Wire Wiring --- */
//   {&q0 &q1 &q2 &q3 &q4 &q5 &q6 &q7 &q8 &q9 &q10 &q11 &q12 &q13} @WIRE { (40, 22) %pq:p } => @TEXT("Q<13:0>") => @SET-STYLE $bus_label_style;
