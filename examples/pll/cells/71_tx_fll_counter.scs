//   %pgate  = $IO_PORT @ATTACH &gate  => @PLACE(2, 12)   => @ORIENT("R0");
//   %preset = $IO_PORT @ATTACH &reset => @PLACE(2, 5)    => @ORIENT("R0");
//   %pq     = $IO_PORT @ATTACH &q0    => @PLACE(204, 22) => @ORIENT("MY");
//   %pq @TEXT("q<13:0>", key="name");
//
//   #XCI @PLACE(8, 10)  => @ORIENT("R0");
//   #XGE @PLACE(16, 10) => @ORIENT("R0");
//   #XG  @PLACE(25, 15) => @ORIENT("R0");
//   #XF0 @PLACE(36, 14) => @ORIENT("R0");
//   #XF1 @PLACE(48, 14) => @ORIENT("R0");
//   #XF2 @PLACE(60, 14) => @ORIENT("R0");
//   #XF3 @PLACE(72, 14) => @ORIENT("R0");
//   #XF4 @PLACE(84, 14) => @ORIENT("R0");
//   #XF5 @PLACE(96, 14) => @ORIENT("R0");
