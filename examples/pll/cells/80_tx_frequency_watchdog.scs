//   {%p_refclk #X0 #X12 #X15 %p_count_gate} @AS(direction="left-to-right") $FLOW;
//   %defect_nx = {#X246 #X262 #X263}(culprit_devices) {&nx}(affected_nets) @AS(
//     severity="critical",
//     category="undriven_floating_net_nx_from_synthesis_tie_cell_omission",
//     mechanism="Net 'nx' has zero drivers in tx_frequency_watchdog_pdk110_80; synthesis hi/lo tie emission bug leaves mux input a floating (tie nx to vss/vdd)",
//     recommendation="Tie net nx to vss (or appropriate constant tie cell) in the synthesized netlist"
//   ) $DESIGN_DEFECT;
//
//   /* --- 2. Structured Column Placement & Orientation --- */
