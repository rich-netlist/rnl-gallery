//   %p_in  = $IO_PORT @ATTACH &inp => @PLACE(2, 10)  => @ORIENT("R0");
//   %p_out = $IO_PORT @ATTACH &out => @PLACE(42, 10) => @ORIENT("MY");
//   #X0 @PLACE(9, 10)  => @ORIENT("R0");
//   #X1 @PLACE(18, 10) => @ORIENT("R0");
//   #X2 @PLACE(27, 10) => @ORIENT("R0");
//   #X3 @PLACE(36, 10) => @ORIENT("R0");
//
//   /* --- 3. Explicit Manhattan Wiring --- */
//   &inp @WIRE { %p_in:p #X0:a };
//   &a   @WIRE { #X0:y #X1:a };
//   &b   @WIRE { #X1:y #X2:a };
//   &c   @WIRE { #X2:y #X3:a };
//   &out @WIRE { #X3:y %p_out:p };
//
//   /* --- 4. Annotations --- */
//   #X0 @TEXT("1x (2.5u/1u)", key="sz", dy=-2.5, halign="middle") => @SET-STYLE $param_style;
//   #X1 @TEXT("2x (5u/2u)",   key="sz", dy=-2.5, halign="middle") => @SET-STYLE $param_style;
