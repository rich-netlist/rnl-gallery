//
//   /* --- 4. Annotations & Defect Callout --- */
//   (61, -6.0) @RECTANGLE(width=96, height=3.8) => @SET-STYLE $defect_box;
//   (61, -5.3) @TEXT("DEFECT: Off-State PMOS Pull-Ups MP0..MP7 (Gate Tied to b0..b7) Degrade Tank Q & Cause Shoot-Through", halign="middle") => @SET-STYLE $defect_style;
//   (61, -6.7) @TEXT("When bi=0, MPi is in strong triode (Ron ~ few kOhm to VDD), shunting RF tank current through Ci and MPi to AC ground instead of high-Z bias", halign="middle") => @SET-STYLE $param_style;
//   (61, 27) @TEXT("tx_cap_bank_switched_v4_pdk110_4: 8-Bit Binary-Weighted Switched MIM Capacitor Bank (4.8 fF .. 614.4 fF)", halign="middle") => @SET-STYLE $title_style;
//   (61, 25.2) @TEXT("Total Tunable Capacitance = 1.224 pF per Side (LSB = 4.8 fF); Controlled by FLL Coarse Word B<7:0>", halign="middle") => @SET-STYLE $subtitle_style
// }
ends tx_cap_bank_switched_v4_pdk110_4
