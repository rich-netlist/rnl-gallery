//   &dclose   @WIRE { #XI:y (24, 23) } => @TEXT("dclose") => @SET-STYLE $fly_label_style;
//
//   &d    @WIRE { %pd:p    #XDATA:a };
//   &init @WIRE { %pinit:p #XINIT:a };
//
//   #XDATA:on  @TEXT("dopen",  dx=0, dy=-1.1, halign="middle") => @SET-STYLE $fly_label_style;
//   #XDATA:off @TEXT("dclose", dx=0, dy=0.5,  halign="middle") => @SET-STYLE $fly_label_style;
//   #XINIT:on  @TEXT("load",   dx=0, dy=-1.1, halign="middle") => @SET-STYLE $fly_label_style;
//   #XINIT:off @TEXT("loadb",  dx=0, dy=0.5,  halign="middle") => @SET-STYLE $fly_label_style;
