//   %pq     = $IO_PORT @ATTACH &q        => @PLACE(46, 12) => @ORIENT("MY");
//   %gnd    = $GROUND  @ATTACH &vss      => @PLACE(27, 0);
//
//   #XEN   @PLACE(10, 23) => @ORIENT("R0");
//   #XI    @PLACE(19, 23) => @ORIENT("R0");
//   #XDATA @PLACE(22, 16) => @ORIENT("R0");
//   #XINIT @PLACE(22, 6)  => @ORIENT("R0");
//   #RKEEP @PLACE(27, 4)  => @ORIENT("R0");
//   #XF    @PLACE(38, 12) => @ORIENT("R0");
