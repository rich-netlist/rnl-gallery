simulator lang=spectre
// @RNL(type="header") { @USE-PACKAGE(name="rnl-std-all", version="0.4"); @USE-PACKAGE(name="rnl-std-semantics", version="0.4");
//   @VERSION("0.4");
//   @USE-PACKAGE(name="pll-semantics", version="0.3", path="../pll_semantics.rnl")
// }
subckt pll_inv_pdk110_9 (a y vdd vss)
MN (y a vss vss) nch w=1.6e-05 l=1.8e-07 nf=1 ad=7.68e-12 as=7.68e-12 pd=3.296e-05 ps=3.296e-05 nrd=0.016875 nrs=0.016875 sa=4.8e-07 sb=4.8e-07 sd=5.4e-07 sca=0 scb=0 scc=0
MP (y a vdd vdd) pch w=4e-05 l=1.8e-07 nf=1 ad=1.92e-11 as=1.92e-11 pd=8.096e-05 ps=8.096e-05 nrd=0.00675 nrs=0.00675 sa=4.8e-07 sb=4.8e-07 sd=5.4e-07 sca=0 scb=0 scc=0
// @RNL(author="gemini-4-argon") {
//   # @SET-SYMBOL(terminals=[[1, "a"], [2, "y"]]) $INVERTER;
//
//   /* --- 1. Circuit Semantics --- */
//   %inv = #MP(pull_up) #MN(pull_down) @AS(role="ref_buf_stage2", skew="balanced", drive_strength="4x (Wp=10u/Wn=4.0u)", channel_length="180nm") $CMOS_INVERTER;
//   /* rnl upgrade: BRANCH adds SERIES routing/topology and a low-priority top-to-bottom ORDER; the old definition only aligned x (16.3) */
// {#MP #MN} @ALIGN("x", priority="low");
//   {%pa #MP %py} @AS $SIGNAL_FLOW; {%pa #MP %py} @ORDER("left-to-right", priority="low");
//   /* Static CMOS inverter has zero quiescent DC current; no static DC current annotated */
//
//   /* --- 2. Schematic Placement & Orientation --- */
//   %pa  = $IO_PORT @ATTACH &a => @PLACE(4, 12) => @ORIENT("R0");
//   %py  = $IO_PORT @ATTACH &y => @PLACE(20, 12) => @ORIENT("MY");
//   %sup = $SUPPLY  @ATTACH &vdd => @PLACE(12, 20);
//   %gnd = $GROUND  @ATTACH &vss => @PLACE(12, 4);
//   #MP @PLACE(12, 16) => @ORIENT("R0");
//   #MN @PLACE(12, 8)  => @ORIENT("R0");
//
//   /* --- 3. Explicit Manhattan Wiring --- */
//   %jg = (7, 12);
//   $JUNCTION @ATTACH %jg => @PLACE(7, 12);
//   &a @WIRE { %pa::pin %jg };
//   &a @WIRE { %jg (7, 16) #MP:g };
//   &a @WIRE { %jg (7, 8)  #MN:g };
//
//   %jy = (12, 12);
//   $JUNCTION @ATTACH %jy => @PLACE(12, 12);
//   &y @WIRE { #MP:d %jy #MN:d };
//   &y @WIRE { %jy %py::pin };
//
//   &vdd @WIRE { %sup::pin #MP:s };
//   &vss @WIRE { #MN:s %gnd::pin };
//
//   /* --- 4. Annotations & Parameter Labels --- */
//   #MP @TEXT("W=${w} L=${l}", key="wl", dx=3.5, dy=0, halign="start") => @SET-STYLE $param_style;
//   #MN @TEXT("W=${w} L=${l}", key="wl", dx=3.5, dy=0, halign="start") => @SET-STYLE $param_style;
//   (12, 25.5) @TEXT("pll_inv_pdk110_9: Reference clock tapered buffer Stage 2 inverter", halign="middle") => @SET-STYLE $title_style;
//   (12, 23.8) @TEXT("Drive: 4x (Wp=10u/Wn=4.0u) | Skew: balanced | L=180nm", halign="middle") => @SET-STYLE $subtitle_style
// }
ends pll_inv_pdk110_9
