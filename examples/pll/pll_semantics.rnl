    @LINE { (-1.2, -0.8) (-0.6, -0.8) (-0.6, -0.3) (0.0, -0.3) (0.0, 0.2) (0.6, 0.2) (0.6, 0.7) (1.2, 0.7) };
    ? @TEXT("${name}", key="name", halign="middle", size=0.65) => @PLACE(0, 2.6)
