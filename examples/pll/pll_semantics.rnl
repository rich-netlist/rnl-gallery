  /* 28. PLL Supervisor FSM (77) */
  $PLL_SUP_SYM = @DEFINE-SYMBOL(box=[-6, -7, 6, 7]) {
    (-6, 6)  @PIN(terminal=1, label="REF", direction="left");
    (-6, 4)  @PIN(terminal=2, label="RST", direction="left");
