    @LINE { (0.8, -2.8) (1.3, -3.5) };
    @LINE { (1.0, -4.2) (-1.0, -3.7) };
    ? @TEXT("${name}", key="name", halign="middle", size=0.65) => @PLACE(0, 8.6)
  };

  /* 25. FLL 14-Bit Ripple Counter (71) */
  $FLL_CNT_SYM = @DEFINE-SYMBOL(box=[-5, -4, 5, 4]) {
    (-5, 2)  @PIN(terminal=1, label="CLK", direction="left");
