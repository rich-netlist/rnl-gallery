    @LINE { (-5, -2) (-4, -2) };
    @LINE { (4, 0) (5, 0) };
    (0, 0) @RECTANGLE(width=8, height=6);
    /* Clock triangle + ascending count staircase + binary stage boxes */
    @LINE { (-4, 2.45) (-3.1, 2.0) (-4, 1.55) };
