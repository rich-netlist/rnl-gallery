    @LINE { (-4, 0) (-3, 0) };
    @LINE { (3, 0) (4, 0) };
    @LINE { (0, 2) (0, 3) };
    (0, 0) @RECTANGLE(width=6, height=4);
    /* AC coupling cap + self-biased inverter triangle + feedback resistor */
    @LINE { (-1.5, 0.6) (-1.5, -0.6) };
    @LINE { (-1.1, 0.6) (-1.1, -0.6) };
    @LINE { (-1.1, 0.0) (-0.6, 0.0) };
