    @LINE { (1.6, -0.3) (1.6, -1.2) };
    @LINE { (-2.0, -1.2) (2.0, -1.2) };
    ? @TEXT("${name}", key="name", halign="middle", size=0.65) => @PLACE(-2, 3.6)
  };

  /* 19. RF Buffer (rf_light24s12): 1=rf, 2=clk, 3=vdd */
  $RF_BUF_SYM = @DEFINE-SYMBOL(box=[-4, -3, 4, 3]) {
    (-4, 0) @PIN(terminal=1, label="RF", direction="left");
    (4, 0)  @PIN(terminal=2, label="CLK", direction="right");
