  };

  /* 20. Programmable Divider Bank (bank_pulsetrip): 1=clk, 2=reset, 3..8=S<5:0>, 9=q1, 10=out, 11=fllclk */
  $DIV_BANK_SYM = @DEFINE-SYMBOL(box=[-6, -4, 6, 4]) {
    (-6, 2)  @PIN(terminal=1, label="CLK", direction="left");
    (-6, 0)  @PIN(terminal=2, label="RST", direction="left");
