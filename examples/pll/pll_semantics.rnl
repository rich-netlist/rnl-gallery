  };

  /* 23. PLL Config Controller (57): 1=refclk, 2=reset, 3=apply, 4..9=K<5:0>, 10..15=AK<5:0>, 16..21=S<5:0>, 22=ready, 23=invalid, 24=divider_reset */
  $PLL_CFG_SYM = @DEFINE-SYMBOL(box=[-6, -6, 6, 6]) {
