    (6, 4)   @PIN(terminal=[10, 11, 12, 13, 14, 15], label="AK<5:0>", direction="right");
    (6, 2)   @PIN(terminal=[16, 17, 18, 19, 20, 21], label="S<5:0>", direction="right");
    (6, 0)   @PIN(terminal=22, label="RDY", direction="right");
    (6, -2)  @PIN(terminal=23, label="INV", direction="right");
    (6, -4)  @PIN(terminal=24, label="CRST", direction="right");
    @LINE { (-6, 4) (-5, 4) };
