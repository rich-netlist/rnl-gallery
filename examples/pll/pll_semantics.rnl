    @LINE { (-6, -3) (-5, -3) };
    @LINE { (5, 4) (6, 4) };
    @LINE { (5, 2) (6, 2) };
    @LINE { (5, 0) (6, 0) };
    @LINE { (5, -2) (6, -2) };
    @LINE { (5, -4) (6, -4) };
    (0, 0) @RECTANGLE(width=10, height=10);
    /* Clock triangle + Shadow/Active Register Grids + Modulus Decoder */
    @LINE { (-5, 4.45) (-4.1, 4.0) (-5, 3.55) };
    (0, 2.2) @RECTANGLE(width=4.4, height=1.6);
    @LINE { (-1.1, 3.0) (-1.1, 1.4) };
    @LINE { (0.0, 3.0) (0.0, 1.4) };
    @LINE { (1.1, 3.0) (1.1, 1.4) };
    (0, -1.8) @RECTANGLE(width=4.4, height=1.6);
    @LINE { (-1.1, -1.0) (-1.1, -2.6) };
    @LINE { (0.0, -1.0) (0.0, -2.6) };
    @LINE { (1.1, -1.0) (1.1, -2.6) };
    @LINE { (0.0, -0.8) (0.0, 1.2) (-0.4, 0.7) };
    @LINE { (0.0, 1.2) (0.4, 0.7) };
    ? @TEXT("${name}", key="name", halign="middle", size=0.65) => @PLACE(0, 5.6)
  };

  /* 24. FLL Recenter Controller (69) */
  $FLL_CORE_SYM = @DEFINE-SYMBOL(box=[-7, -8, 7, 8]) {
    (-7, 6)  @PIN(terminal=1, label="REF", direction="left");
    (-7, 3)  @PIN(terminal=2, label="RST", direction="left");
