    ? @TEXT("${name}", key="name", halign="middle", size=0.65) => @PLACE(0, 3.6)
  };

  /* 21. Retimer (rt_noise_scale4): 1=data, 2=clk, 3=out, 4=vdd */
  $RETIMER_SYM = @DEFINE-SYMBOL(box=[-4, -3, 4, 3]) {
