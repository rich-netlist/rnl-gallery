//   {#"M3" #"M1"}(reference_branch) {#"M13" #"M12" #"M10" #"M11" #"M9" #"M8" #"M6" #"M7" #"M5" #"M4" #"M2" #"M0"}(cascode_mirror_branches) %expanded_0(rc_noise_filter) @AS(role="high_swing_series_cascode_bias_mirror", channels=6) $CASCODE_CURRENT_MIRROR_BANK;
//   {#"M3" #"M1"}(ref) {#"M13" #"M12" #"M10" #"M11" #"M9" #"M8" #"M6" #"M7" #"M5" #"M4" #"M2" #"M0"}(out) @AS $CURRENT_MIRROR;
//   {#"M3" #"M13" #"M10" #"M9" #"M6" #"M5" #"M2"}(members) @AS $MATCHED;
//   {#"M1" #"M12" #"M11" #"M8" #"M7" #"M4" #"M0"}(members) @AS $MATCHED;
