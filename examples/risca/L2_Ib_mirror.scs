//   @RECTANGLE {(-25, 75.03) (228.53, 96.23)} => @SET-STYLE $risca_note_box;
//   (-21, 89.25) @TEXT("L2_Ib_mirror: 6-Channel Series-Cascode Bias Current Mirror (15uA Master Reference -> 6 x 15uA Channel Outputs)", size=3) => @SET-STYLE $risca_title_style;
//   (-21, 84.25) @TEXT("1. Self-Cascoded Reference (M3+M1, l=100n, w=2u): R0 (6x4u poly) ties IIN (~630mV) to VDCAP at DC (zero DC drop) while forming an RC noise filter with external C0.", size=2.5) => @SET-STYLE $risca_bias_style;
//   (-21, 79.25) @TEXT("2. 6 Matched Output Branches: (M13/M12 -> IOUT_0) .. (M2/M0 -> IOUT_5) operate as composite L=200n cascode current sinks (~560mV drain compliance).", size=2.5) => @SET-STYLE $risca_bias_style
// }
ends L2_Ib_mirror
