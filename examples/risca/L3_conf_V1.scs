//   @USE-PACKAGE(name="risca-semantics", version="0.3", path="risca_semantics.rnl");
//   /* L3_conf_V1: 22-Bit SPI Serial-In Parallel-Out Static Configuration Register with Reset Masking & 100ps SCK Skew Buffer */
