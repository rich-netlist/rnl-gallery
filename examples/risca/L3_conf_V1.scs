//   (-102, 98.25) @TEXT("1. 22-Bit Shift Chain: I0<21:0> (DFQD1) shifts SDI -> D<0..21> -> I3 -> SDO on buffered clock net1.", size=2.5) => @SET-STYLE $risca_digital_style;
//   (-102, 93.25) @TEXT("2. Reset Masking & Clock Skew: INR2D4 array I2<21:0> forces OUT<21:0>=0 when RST=1; DEL100D1 (I129) delays SCKI->SCKO by 100ps for daisy-chain hold margin.", size=2.5) => @SET-STYLE $risca_digital_style
// }
