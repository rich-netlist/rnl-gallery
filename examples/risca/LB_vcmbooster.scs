//   @RECTANGLE {(-68, 143.03) (140.34, 174.23)} => @SET-STYLE $risca_note_box;
//   (-64, 167.25) @TEXT("LB_vcmbooster: 4-Bit Aperture-Skew-Tunable Gated Clock Voltage Booster for Top-Plate VCM Sampling (SAM_GATE)", size=3) => @SET-STYLE $risca_title_style;
//   (-64, 162.25) @TEXT("1. Gating Logic: Only when SAM=1 and CLK=1 does M2+M3 pull net1=AVSS, driving net2=AVDD and boosting VBTSTP to ~2*AVDD.", size=2.5) => @SET-STYLE $risca_swcap_style;
//   (-64, 157.25) @TEXT("2. Aperture Skew Calibration (TUNE_3:0): Controls PMOS header array (M9 fixed + M10 1x + M14 0.5x + M15:M16 0.25x + M18..M20 0.125x)", size=2.5) => @SET-STYLE $risca_swcap_style;
//   (-64, 152.25) @TEXT("   supplying net7. When CLK falls (sampling instant!), M8 pulls net1 high through net7, turning off VBTSTP with sub-ps tunable delay.", size=2.5) => @SET-STYLE $risca_swcap_style;
//   (-64, 147.25) @TEXT("3. Layout Dummy: M21 (gate=source=AVDD) is an always-off dummy PMOS attached to net7 for diffusion matching.", size=2.5) => @SET-STYLE $risca_bias_style
