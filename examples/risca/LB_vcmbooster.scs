//   @USE-PACKAGE(name="risca-semantics", version="0.3", path="risca_semantics.rnl");
//   /* LB_vcmbooster: 4-Bit Skew-Tunable Gated Clock Voltage Doubler for Top-Plate Sampling Switch (SAM_GATE) */
//   {#"I0" #"I1" #"I2" #"I3"}(tune_inverters) {#"M5" #"M8" #"M2" #"M3"}(gated_predriver) {#"M9" #"M10" #"M14" #"M15" #"M16" #"M18" #"M17" #"M19" #"M20" #"M21"}(programmable_pmos_header) {#"M0" #"M1" #"C0" #"M7" #"M4" #"M11"}(doubler_core) @AS(role="skew_tunable_sampling_clock_booster", tuning_bits=4) $TUNABLE_GATED_BOOSTER;
//   {#"M0" #"M1"}(driver_inverter) #"C0"(flying_cap) #"M7"(precharge_switch) #"M4"(boost_pass_switch) #"M11"(discharge_switch) @AS(role="capacitive_clock_voltage_doubler", boost_level="2x_AVDD_when_SAM_and_CLK_high") $CLK_VOLTAGE_DOUBLER;
//   {#"I0" #"I1" #"I2" #"I3"}(members) @AS $MATCHED;
//   {#"M9" #"M10" #"M14" #"M15" #"M16" #"M18" #"M17" #"M19" #"M20"}(members) @AS $MATCHED;
//   {#"M8" #"M2" #"M3"}(members) @AS $BRANCH;
//   {#"M0" #"M1"}(members) @AS $BRANCH;
