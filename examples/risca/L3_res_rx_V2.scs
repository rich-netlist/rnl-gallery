//   @USE-PACKAGE(name="risca-semantics", version="0.3", path="risca_semantics.rnl");
//   /* L3_res_rx_V2: Current-Mode Shared-Bus Residue Receiver (Common-Gate Input + 1:4 Cascode Mirror + 4-Bit RTUNE TIA + HBW Filter) */
//   {#"I38" #"I39" #"I44" #"I40" #"I41" #"I43" #"I42" #"I36" #"I37"}(bus_select_switches) #"M8"(pmos_cg) #"M54"(pmos_en) #"M6"(nmos_cg) #"M57"(nmos_en) @AS(role="complementary_common_gate_current_input_stage") $COMMON_GATE_CURRENT_BUFFER;
//   {#"M39" #"M35" #"M1" #"M36"}(pmos_1to4_cascode_mirror) {#"M26" #"M27" #"M0" #"M29"}(nmos_1to4_cascode_mirror) @AS(role="complementary_1to4_cascode_current_mirror_amplifier", current_gain="4x_65uA_to_260uA") $CASCODE_MIRROR_GAIN_STAGE;
//   #"R20"(fixed_resistor) {%expanded_1 %expanded_2 %expanded_3 #"R21"}(programmable_resistor_branches) {#"I23" #"I22" #"I21" #"I20" #"I30" #"I31" #"I28" #"I29" #"I26" #"I27" #"I24" #"I25"}(rtune_switches) @AS(role="4bit_RTUNE_transimpedance_resistor_load") $TUNABLE_TIA_LOAD;
//   %expanded_0(series_resistors) #"I32"(hbw_bypass_switch) {#"I33" #"I34"}(control_inverters) @AS(role="programmable_bandwidth_RC_filter") $SWITCHABLE_RC_FILTER;
//   {#"I47" #"I46" #"I45"}(caps) @AS(role="switch_supply_decap", substrate_tap="3x_DCAP4_stdcell") $MOM_DECAP;
//   {#"M39" #"M35"}(ref) {#"M1" #"M36"}(out) @AS $CURRENT_MIRROR;
//   {#"M26" #"M27"}(ref) {#"M0" #"M29"}(out) @AS $CURRENT_MIRROR;
//   {#"M39" #"M1"}(members) @AS $MATCHED;
//   {#"M35" #"M36"}(members) @AS $MATCHED;
//   {#"M26" #"M0"}(members) @AS $MATCHED;
//   {#"M27" #"M29"}(members) @AS $MATCHED;
//   {#"I38" #"I39" #"I44"}(members) @AS $MATCHED;
//   {#"I20" #"I21" #"I22" #"I23"}(members) @AS $MATCHED;
//   {#"M39" #"M35" #"M54" #"M8" #"M6" #"M57" #"M27" #"M26"}(members) @AS $BRANCH;
//   {#"M1" #"M36" #"M29" #"M0"}(members) @AS $BRANCH;
//   /* Deterministic Static DC Quiescent Currents (65uA Reference Column & 260uA 4x Output Column when EN=1) */
//   #"M39":3 @CURRENT("in"); #"M39":1 @CURRENT("out");
//   #"M35":3 @CURRENT("in"); #"M35":1 @CURRENT("out");
//   #"M54":3 @CURRENT("in"); #"M54":1 @CURRENT("out");
//   #"M8":1 @CURRENT("in"); #"M8":3 @CURRENT("out");
//   #"M6":3 @CURRENT("in"); #"M6":1 @CURRENT("out");
//   #"M57":3 @CURRENT("in"); #"M57":1 @CURRENT("out");
//   #"M27":1 @CURRENT("in"); #"M27":3 @CURRENT("out");
//   #"M26":1 @CURRENT("in"); #"M26":3 @CURRENT("out");
//   #"M1":3 @CURRENT("in"); #"M1":1 @CURRENT("out");
//   #"M36":3 @CURRENT("in"); #"M36":1 @CURRENT("out");
//   #"M29":1 @CURRENT("in"); #"M29":3 @CURRENT("out");
//   #"M0":1 @CURRENT("in"); #"M0":3 @CURRENT("out");
