//   /* Note Box & Author Header (Placed in Empty Region Above Schematic) */
//   (-172, 204.07) @TEXT("Comment by Gemini-4-Argon", size=2.8) => @SET-STYLE $risca_author_style;
//   @RECTANGLE {(-172, 175.03) (92.08, 201.23)} => @SET-STYLE $risca_note_box;
//   (-168, 194.25) @TEXT("L3_res_rx_V2: Current-Mode Residue Receiver (Common-Gate Input + 1:4 Cascode Mirror + 4-Bit Tunable TIA + HBW Filter)", size=3) => @SET-STYLE $risca_title_style;
//   (-168, 189.25) @TEXT("1. Bus Select & CG Input (65uA): Selects BUS_1 (MR_1), BUS_2 (MR_2), or VCM (EN=0) into low-impedance CG node IIN (~550mV) biased by M8 (PMOS) & M6 (NMOS).", size=2.5) => @SET-STYLE $risca_analog_style;
//   (-168, 184.25) @TEXT("2. 1:4 Current Amplification (260uA): Cascode mirrors (M39/M35 -> 4x M1/M36 and M26/M27 -> 4x M0/M29, cascode gates at VCM) provide 4x current gain into VOP.", size=2.5) => @SET-STYLE $risca_analog_style;
//   (-168, 179.25) @TEXT("3. 4-Bit TIA & Bandwidth Select: RTUNE_3:0 switches parallel poly branches (1R, 2R, 4R, 9R + fixed R20) between VOP and VCM; R19 (2x1.875u) is bypassed by I32 when HBW=1.", size=2.5) => @SET-STYLE $risca_swcap_style
// }
ends L3_res_rx_V2
