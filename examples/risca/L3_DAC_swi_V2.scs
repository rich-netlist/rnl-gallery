//   {%bundle_0 %bundle_1}(caps) @AS(role="digital_driver_supply_decap", substrate_tap="6x_DCAP8_plus_11x_DCAP16") $MOM_DECAP;
//   /* 5-Bit MSB Bottom-Plate Switch Slices (Binary-Scaled Multipliers: 16x, 8x, 4x, 2x, 1x) */
