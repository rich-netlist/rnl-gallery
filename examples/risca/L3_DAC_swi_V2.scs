//   (-116, 205.14) @TEXT("1. Break-Before-Make Timing: On SH rising edge, OR2 I23 immediately disables VREFP/VREFN (EN=0, ENB=1), while AN2 I20 + DEL025 I25 delay", size=3.8) => @SET-STYLE $risca_swcap_style;
//   (-116, 197.64) @TEXT("   BS rising edge by 25ps before LB_bs_gen_V3 (I59) boosts GATE = VDDSAM + VIN. On SH falling edge, GATE turns off 25ps before EN=1.", size=3.8) => @SET-STYLE $risca_swcap_style;
//   (-116, 190.14) @TEXT("2. Binary-Scaled Switch Sizing: MSB_4..0 scale multi = 16, 8, 4, 2, 1 (unit w=1u PMOS / 800n NMOS) for uniform RC settling time constant.", size=3.8) => @SET-STYLE $risca_swcap_style
// }
ends L3_DAC_swi_V2
