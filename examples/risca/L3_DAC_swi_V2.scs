//   {#"I28" #"I29"}(pre_driver_gates) #"M7"(pmos_vrefp) #"M8"(nmos_vrefn) #"M6"(nmos_vin_bootstrapped) @AS(role="MSB2_64C_4x_switch_slice", bit_name="VMSB_2") $DAC_BIT_SWITCH_SLICE;
//   {#"I30" #"I31"}(pre_driver_gates) #"M10"(pmos_vrefp) #"M11"(nmos_vrefn) #"M9"(nmos_vin_bootstrapped) @AS(role="MSB1_32C_2x_switch_slice", bit_name="VMSB_1") $DAC_BIT_SWITCH_SLICE;
//   {#"I32" #"I33"}(pre_driver_gates) #"M13"(pmos_vrefp) #"M14"(nmos_vrefn) #"M12"(nmos_vin_bootstrapped) @AS(role="MSB0_16C_1x_switch_slice", bit_name="VMSB_0") $DAC_BIT_SWITCH_SLICE;
//   /* 6-Bit LSB Bottom-Plate Switch Slices */
//   {#"I36" #"I35"}(pre_driver_gates) #"M19"(pmos_vrefp) #"M17"(nmos_vrefn) #"M18"(nmos_vin_bootstrapped) @AS(role="LSB5_16C_redundant_switch_slice", bit_name="VLSB_5") $DAC_BIT_SWITCH_SLICE;
//   {#"I43" #"I42"}(pre_driver_gates) #"M28"(pmos_vrefp) #"M27"(nmos_vrefn) #"M29"(nmos_vin_bootstrapped) @AS(role="LSB4_8C_switch_slice", bit_name="VLSB_4") $DAC_BIT_SWITCH_SLICE;
//   {#"I41" #"I40"}(pre_driver_gates) #"M25"(pmos_vrefp) #"M24"(nmos_vrefn) #"M26"(nmos_vin_bootstrapped) @AS(role="LSB3_4C_switch_slice", bit_name="VLSB_3") $DAC_BIT_SWITCH_SLICE;
//   {#"I39" #"I38"}(pre_driver_gates) #"M22"(pmos_vrefp) #"M21"(nmos_vrefn) #"M23"(nmos_vin_bootstrapped) @AS(role="LSB2_4C_redundant_switch_slice", bit_name="VLSB_2") $DAC_BIT_SWITCH_SLICE;
//   {#"I37" #"I34"}(pre_driver_gates) #"M20"(pmos_vrefp) #"M15"(nmos_vrefn) #"M16"(nmos_vin_bootstrapped) @AS(role="LSB1_2C_switch_slice", bit_name="VLSB_1") $DAC_BIT_SWITCH_SLICE;
//   {#"I44" #"I45"}(pre_driver_gates) #"M30"(pmos_vrefp) #"M32"(nmos_vrefn) #"M31"(nmos_vin_bootstrapped) @AS(role="LSB0_1C_switch_slice", bit_name="VLSB_0") $DAC_BIT_SWITCH_SLICE;
