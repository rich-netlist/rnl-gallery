//   @RECTANGLE {(-107, 116.03) (184.19, 142.23)} => @SET-STYLE $risca_note_box;
//   (-103, 135.25) @TEXT("L3_bridge_cap_V2: Reconfigurable Series Bridge Capacitor & Dual Switched-Cap Residue Summing Network (9fF Unit Sandwich Caps)", size=3) => @SET-STYLE $risca_title_style;
//   (-103, 130.25) @TEXT("1. Main Series Bridge (I31<16:0> = 17x9fF = 153fF): Couples CDAC to CMP; bypassed by 4x LB_trangate I1<3:0> when SRT=1 (direct SAR mode).", size=2.5) => @SET-STYLE $risca_swcap_style;
//   (-103, 125.25) @TEXT("2. Branch 1 (1x Weight, I30<4:0> = 5x9fF = 45fF): Samples (VRESP-VRESG) via I10/I12 on (CLK & RS1); couples into (CDAC, CMP) via I6/I7 on CS1.", size=2.5) => @SET-STYLE $risca_swcap_style;
//   (-103, 120.25) @TEXT("3. Branch 2 (2x Weight, I29<9:0> = 10x9fF = 90fF): Samples (VRESP-VRESG) via I23/I24 on (CLK & RS2); couples into (CDAC, CMP) via I25/I26 on CS2 (enables 1x/2x/3x residue & 2nd-order NS!).", size=2.5) => @SET-STYLE $risca_swcap_style
// }
ends L3_bridge_cap_V2
