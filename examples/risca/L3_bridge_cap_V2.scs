//   @USE-PACKAGE(name="risca-semantics", version="0.3", path="risca_semantics.rnl");
//   /* L3_bridge_cap_V2: Programmable Series Bridge & Dual Switched-Capacitor Residue Summing Network */
//   %bundle_2(series_cap_bank) %bundle_0(bypass_trangates) {#"I2" #"I3"}(control_inverters) @AS(role="series_attenuation_bridge_cap_with_SRT_bypass", capacitance="17x9fF_153fF") $BYPASSABLE_BRIDGE_CAP;
//   %bundle_1(branch_cap_bank) {#"I10" #"I12"}(residue_sample_switches) {#"I6" #"I7"}(cdac_couple_switches) {#"I36" #"I8" #"I9" #"I4" #"I5"}(control_logic) @AS(role="Branch1_1x_switched_residue_injector", weight="5C_45fF") $SWITCHED_RESIDUE_BRANCH;
//   %bundle_3(branch_cap_bank) {#"I23" #"I24"}(residue_sample_switches) {#"I25" #"I26"}(cdac_couple_switches) {#"I35" #"I14" #"I13" #"I27" #"I28"}(control_logic) @AS(role="Branch2_2x_switched_residue_injector", weight="10C_90fF") $SWITCHED_RESIDUE_BRANCH;
//   {%bundle_2 %bundle_1 %bundle_3}(members) @AS $MATCHED;
//   {#"I10" #"I12" #"I6" #"I7" #"I23" #"I24" #"I25" #"I26"}(members) @AS $MATCHED;
