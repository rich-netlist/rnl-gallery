//   @USE-PACKAGE(name="risca-semantics", version="0.3", path="risca_semantics.rnl");
//   /* L1_clk_buffer: Complementary Self-Biased Differential-to-Single-Ended Clock Receiver (Bazes Topology) + Tapered CMOS Buffer */
