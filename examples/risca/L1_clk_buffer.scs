//   @RECTANGLE {(-2, 38.03) (266.6, 59.23)} => @SET-STYLE $risca_note_box;
//   (2, 52.25) @TEXT("L1_clk_buffer: 1.0-1.2 GHz Complementary Self-Biased Diff-to-SE Clock Receiver (Bazes Amp) + Tapered Inverter Chain", size=3) => @SET-STYLE $risca_title_style;
//   (2, 47.25) @TEXT("1. Self-Biased Bazes Stage: Complementary pairs M3/M4 (PMOS) & M0/M1 (NMOS) self-bias tail sources M5 & M2 via replica node net4; M6 & M15 stabilize tail nodes net10 & net5.", size=2.5) => @SET-STYLE $risca_analog_style;
//   (2, 42.25) @TEXT("2. Tapered Rail-to-Rail Output Buffer: Stage-1 inverter M11/M8 (w=6u) -> Stage-2 inverter M10/M9 (w=16u) -> CLK; decoupled by M13, M12, M16, M7.", size=2.5) => @SET-STYLE $risca_analog_style
// }
ends L1_clk_buffer
