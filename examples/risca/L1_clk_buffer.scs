//   {#"M13" #"M12" #"M16" #"M7" #"M6" #"M15"}(mos_caps) @AS(role="MOS_gate_oxide_decoupling_capacitor") $MOS_DECAP;
//   #"M0"(in_p) #"M1"(in_n) #"M2"(tail) @AS $DIFFERENTIAL_PAIR;
//   #"M3"(in_p) #"M4"(in_n) #"M5"(tail) @AS $DIFFERENTIAL_PAIR;
//   {#"M0" #"M1"}(members) @AS $MATCHED;
//   {#"M3" #"M4"}(members) @AS $MATCHED;
