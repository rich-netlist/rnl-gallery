//   #"M0"(a) #"M1"(b) %ax_clk(axis) @AS $MIRRORED;
//   {#"M11" #"M8"}(members) @AS $BRANCH;
//   {#"M10" #"M9"}(members) @AS $BRANCH;
//   {#"M1" #"M11" #"M10" %port_1}(path) @AS(direction="left-to-right") $FLOW;
//   /* Deterministic Static DC Quiescent Currents in Self-Biased Bazes Input Stage */
//   #"M5":3 @CURRENT("in"); #"M5":1 @CURRENT("out");
//   #"M3":3 @CURRENT("in"); #"M3":1 @CURRENT("out");
//   #"M4":3 @CURRENT("in"); #"M4":1 @CURRENT("out");
//   #"M0":1 @CURRENT("in"); #"M0":3 @CURRENT("out");
//   #"M1":1 @CURRENT("in"); #"M1":3 @CURRENT("out");
//   #"M2":1 @CURRENT("in"); #"M2":3 @CURRENT("out");
//   {#"M3" #"M0"}(members) @AS $BRANCH;
//   {#"M4" #"M1"}(members) @AS $BRANCH;
