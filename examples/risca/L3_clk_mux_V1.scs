//   /* Note Box & Author Header (Placed in Empty Region Above Schematic) */
//   (-130, 185.12) @TEXT("Comment by Gemini-4-Argon", size=4.2) => @SET-STYLE $risca_author_style;
//   @RECTANGLE {(-130, 142.05) (259.79, 180.86)} => @SET-STYLE $risca_note_box;
//   (-124, 170.64) @TEXT("L3_clk_mux_V1: 16-Phase x 24-Operation SPI-Programmable Crossbar Clock Synthesizer (384 LB_crossbar_cell + 25 Extra DFFs = 409 SPI Bits)", size=4.5) => @SET-STYLE $risca_title_style;
//   (-124, 163.14) @TEXT("1. Row Gating: 16 CKAN2D4 gates enable FRAME<15:0> via channel-enable DFF I1260 (net69); 15 CKAN2D4 gates mask REPET<17:1> during RST=1.", size=3.8) => @SET-STYLE $risca_digital_style;
//   (-124, 155.64) @TEXT("2. 24 Dynamic Evaluation Columns: Each column ORs selected FRAME<15:0> phases onto dynamic row wire, with repetition precharge/hold controlled by REPET_4 & REPET_9.", size=3.8) => @SET-STYLE $risca_digital_style;
//   (-124, 148.14) @TEXT("3. 50ps De-Glitch Pulse Shapers: Each column output passes through DEL050D1 + NR2D1 + BUFFD4 to suppress <50ps crossbar transition glitches before driving OUT<23:0>.", size=3.8) => @SET-STYLE $risca_digital_style
// }
ends L3_clk_mux_V1
