//   @USE-PACKAGE(name="risca-semantics", version="0.3", path="risca_semantics.rnl");
//   /* L3_clk_mux_V1: 16x24 SPI-Programmable Dynamic Crossbar Clock Synthesizer (384 LB_crossbar_cell Matrix) */
//   {#"I1260" #"I1215" #"I1220" #"I1218" #"I1213" #"I1210" #"I1205" #"I1207" #"I1212" #"I1199" #"I1204" #"I1202" #"I1197" #"I1195" #"I1193" #"I1191" #"I1189"}(frame_row_gates) {#"I1637" #"I1621" #"I1622" #"I1623" #"I1635" #"I1624" #"I1625" #"I1626" #"I1627" #"I1628" #"I1629" #"I1630" #"I1631" #"I1632" #"I1633" #"I1634"}(repet_row_gates) {#"I415" #"I879" #"I903" #"I1569" #"I1607"}(crossbar_384_cells) {#"I1535" #"I1538" #"I1537" #"I1487" #"I1490" #"I1489" #"I1552" #"I1551" #"I1550"}(column_eval_and_shapers) @AS(role="16x24_SPI_programmable_frame_to_clock_crossbar") $CROSSBAR_MATRIX_ARRAY;
//   /* Representative 50ps Rising-Edge De-Glitch Pulse Shapers on Output Columns OUT_0, OUT_12, OUT_23 */
//   #"I1535"(delay_50ps) #"I1538"(nor_gate) #"I1537"(out_buffer) @AS(role="OUT0_50ps_deglitch_pulse_shaper") $DEGLITCH_PULSE_SHAPER;
//   #"I1487"(delay_50ps) #"I1490"(nor_gate) #"I1489"(out_buffer) @AS(role="OUT12_50ps_deglitch_pulse_shaper") $DEGLITCH_PULSE_SHAPER;
//   #"I1552"(delay_50ps) #"I1551"(nor_gate) #"I1550"(out_buffer) @AS(role="OUT23_50ps_deglitch_pulse_shaper") $DEGLITCH_PULSE_SHAPER;
//   {#"I1215" #"I1220" #"I1218" #"I1213" #"I1210" #"I1205" #"I1207" #"I1212" #"I1199" #"I1204" #"I1202" #"I1197" #"I1195" #"I1193" #"I1191" #"I1189"}(members) @AS $MATCHED;
//   {#"I1535" #"I1538" #"I1537"}(path) @AS(direction="left-to-right") $FLOW;
//   {#"I1260" #"I1215" #"I1220" #"I1218" #"I1213" #"I1210" #"I1205" #"I1207" #"I1212" #"I1199" #"I1204" #"I1202" #"I1197" #"I1195" #"I1193" #"I1191" #"I1189"}(members) @AS $BRANCH;
