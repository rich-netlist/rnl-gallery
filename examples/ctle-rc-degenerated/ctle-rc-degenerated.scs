// Continuous-time linear equalizer (CTLE): source RC-degenerated NMOS differential pair
// The RC bridge RS || CS between the two sources gives the peaking; matched resistor loads and matched tail current
// sinks. The top level drives it with differential sine sources.
// @RNL(type="header") { @USE-PACKAGE(name="rnl-std-all", version="0.4"); @USE-PACKAGE(name="rnl-std-no-instance-labels", version="0.4"); @USE-PACKAGE(name="rnl-std-semantics", version="0.4"); @VERSION("0.4")}
simulator lang=spectre

model nch mos1 type=n vto=0.45 kp=200u lambda=0.05

subckt ctle inp inn outp outn vdd vss vb
RD1 (vdd outn) resistor r=1.5k
RD2 (vdd outp) resistor r=1.5k
M1 (outn inp s1 vss) nch w=60u l=0.3u
M2 (outp inn s2 vss) nch w=60u l=0.3u
RS (s1 s2) resistor r=1k
CS (s1 s2) capacitor c=200f
MT1 (s1 vb vss vss) nch w=30u l=0.3u
MT2 (s2 vb vss vss) nch w=30u l=0.3u
// @RNL {
//   &vdd @ADD-TO $SUPPLY_NET_SET;
//   &vss @ADD-TO $GROUND_NET_SET;
//   &vb @ADD-TO $BIAS_NET_SET;
//   $IO_PORT @ATTACH &inp => %p_inp;
//   $IO_PORT @ATTACH &inn => %p_inn;
//   $IO_PORT @ATTACH &outn => %p_outn;
//   $IO_PORT @ATTACH &outp => %p_outp;
//   %routed_nets = # @SELECT-NET;
//   %routed_nets @ROUTE-NET;
//
//   {#RD1:p #RD2:p #M1:d #M2:d #MT1:d #MT2:d} @CURRENT("in");
//   {#RD1:n #RD2:n #M1:s #M2:s #MT1:s #MT2:s} @CURRENT("out");
//
//   /* what the circuit is: a differential pair whose sources are bridged by RS || CS, giving a zero (the equalizer's
//      boost), loaded by matched resistors, with a matched tail current sink for each side */
//   %rc_deg = {#RS #CS} @AS $PARALLEL_VERTICAL;
//   %dp_h = #M1(left) #M2(right) #MT1(tailleft) #MT2(tailright) %rc_deg(bridge) @AS $DEGENERATED_DIFFERENTIAL_PAIR_TYPE_H;
//   %rd = {#RD1 #RD2} @AS $MATCHED_RESISTOR;
//   %amp = %dp_h(transconductor) %rd(load) @AS $TRANSCONDUCTOR_Z_AMPLIFIER;
//   %flow = {%dp_h #RD1 #RD2}(path) {%p_inp %p_inn}(source) {%p_outn %p_outp}(load) @AS $SIGNAL_FLOW;
//
//   /* the two columns are branches from the supply to the ground: the load resistor on top, the input NMOS in the
//      middle, the matched tail current sink at the bottom */
//   %br_left = {#RD1 #M1 #MT1} @AS $BRANCH;
//   %br_right = {#RD2 #M2 #MT2} @AS $BRANCH;
//
//   /* the parallel degeneration bridge RS and CS lies vertically across the H between the two source nodes, RS above
//      CS, between the two columns */
//   %bridge_order = {%br_left %rc_deg %br_right} @ORDER("left-to-right");
//
//   /* the two tail current sinks are mirror images of each other, the gate of the left one facing left: both
//      gates face outwards, like those of the input pair */
//   %tails_mirrored = #MT1 #MT2 @ORIENT-RELATION("MY");
//   %mt1_gate_left = #MT1:g @ORIENT("left");
//
//   /* the two output ports are mirror images of each other, like the input ports */
//   %out_ports_mirrored = %p_outn %p_outp @ORIENT-RELATION("MY");
//
//   /* the block symbol drawn for the instances of ctle */
